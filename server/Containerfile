# Training Analyze server image: the web app (and the terminal app, via podman exec) with
# the athlete's files in the /data volume. Build from the repository root:
#   podman build -t training-analyze -f server/Containerfile .
FROM docker.io/library/python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    TA_HOME=/data \
    TZ=Europe/Warsaw

# tzdata: dates (calendar weeks, nightly run, exports) follow TZ.
RUN apt-get update \
    && apt-get install -y --no-install-recommends tzdata \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY src/requirements-server.txt src/
RUN pip install --no-cache-dir -r src/requirements-server.txt
COPY src/ src/
# The commit the image was built from (server/update.sh); the app logs it at startup.
ARG TA_VERSION=unknown
ENV TA_VERSION=$TA_VERSION

# Unprivileged user 1000; the server's quadlet maps the host account onto it (UserNS=keep-id)
# so files in the data folder belong to that account on the host too.
RUN useradd --uid 1000 --create-home app && mkdir /data && chown app:app /data
USER app
VOLUME /data
EXPOSE 8080

HEALTHCHECK --interval=60s --timeout=5s --start-period=30s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=4)"

# TA_PASSWORD must be set (the quadlet's EnvironmentFile): the app refuses to listen on the
# network without one.
CMD ["python", "src/web.py", "--host", "0.0.0.0", "--port", "8080", "--server", "--no-browser"]
